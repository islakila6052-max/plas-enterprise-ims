# ============================================================================
# COPY THIS FILE TO `.env` AND FILL IN YOUR OWN VALUES.  NEVER COMMIT `.env`.
# ============================================================================
# `.env` is git-ignored. `.env.example` MUST contain placeholders only —
# never paste real keys/URLs here, or they will be pushed to the remote.
#
#  !! SECURITY: the service-role key is a MASTER key. It bypasses RLS, can
#  !! read/write every table, and can create or delete any auth user.
#  !! It must exist ONLY in the Vercel dashboard (server-side env vars) and
#  !! in your local untracked `.env`. It must NEVER be:
#  !!   - committed to git (this file included)
#  !!   - prefixed with VITE_ (Vite inlines VITE_* vars into the browser bundle)
#  !!   - sent to, or readable from, the client
# ============================================================================

# --- Frontend (safe to expose; these are compiled into the browser bundle) ---
VITE_SUPABASE_URL=YOUR_SUPABASE_URL_HERE
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE
VITE_APP_URL=YOUR_APP_URL_HERE

# --- Server-only (NEVER prefix these with VITE_) ---------------------------
# Set these in Vercel -> Project -> Settings -> Environment Variables.
# They are read at runtime by the /api serverless functions only.
SUPABASE_URL=YOUR_SUPABASE_URL_HERE
SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY_HERE

# --- Dev/test scripts only (throwaway test-user password; lives in local .env) ---
TEST_USER_PASSWORD=YOUR_TEST_USER_PASSWORD_HERE

# --- Supabase new-style API keys (placeholders; real values live only in .env / Vercel) ---
SECRET_KEY=YOUR_SB_SECRET_KEY_HERE
PUBLISHABLE_KEY=YOUR_SB_PUBLISHABLE_KEY_HERE